# Скопируйте в .env и заполните реальными значениями (см. deploy-guide.md, шаг 5).
# .env НИКОГДА не коммитить — уже в .gitignore.

# ---- Django ----
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=platya.kz,www.platya.kz,82.115.49.183
CSRF_TRUSTED_ORIGINS=https://platya.kz

# ---- База данных (имена совпадают с docker-compose.yml) ----
DB_NAME=dress_db
DB_USER=dress_app
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# ---- Приложение / auth-модуль ----
# Базовый URL, на который формируются ссылки в письмах (set-password, reset-password).
APP_BASE_URL=https://platya.kz
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1
REFRESH_TTL_HOURS=24
IDLE_TIMEOUT_MINUTES=60

# ---- SMTP (для писем регистрации/сброса пароля) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=False
SMTP_FROM=no-reply@platya.kz
